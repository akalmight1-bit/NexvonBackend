# --- Cloud chat providers ---
XAI_API_KEY=
XAI_MODEL=grok-4.5

NVIDIA_API_KEY=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_MODEL=meta/llama-3.1-70b-instruct

# --- Local chat (Ollama) ---
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.2:3b

# OpenAI-compatible self-host (vLLM, TGI, llama.cpp server)
# LOCAL_BASE_URL=http://127.0.0.1:8001/v1
# LOCAL_API_KEY=
# LOCAL_MODEL=llama3.1

DEFAULT_PROVIDER=ollama
FALLBACK_PROVIDER=ollama

# --- Local speech (downloaded models) ---
STT_ENABLED=true
WHISPER_MODEL=base
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8
# WHISPER_DOWNLOAD_ROOT=models/whisper

TTS_ENABLED=true
# PIPER_MODEL_PATH=models/piper/en_US-lessac-medium.onnx
# PIPER_CONFIG_PATH=models/piper/en_US-lessac-medium.onnx.json
PIPER_SPEAKER=0
PIPER_LENGTH_SCALE=1.0

# --- Server ---
HOST=0.0.0.0
PORT=8000
CORS_ORIGINS=http://localhost:8080,http://127.0.0.1:8080
